# Copy to .env for local dev, or set these in Vercel -> Project -> Settings -> Environment Variables.
# Leave everything blank and the dashboard runs on the bundled sample data with no login.

# --- Your data (both required to go live; the dashboard reads them server-side only) ---
# Same Supabase project the garmin-claude-coach pull writes to.
GARMIN_SUPABASE_URL=
GARMIN_SUPABASE_SERVICE_ROLE_KEY=

# --- AI coach chat (optional). Without it the chat shows a "add your key" note. ---
# Get one at https://console.anthropic.com. Never commit it, never put it in the browser.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Password gate (strongly recommended once it is YOUR data) ---
# Set a password and every data route needs the login cookie. Pick a long random token too.
GH_PASSWORD=
GH_SESSION_TOKEN=
